# Lombok configuration.
#
# addLombokGeneratedAnnotation is load-bearing, not cosmetic: it stamps
# @lombok.Generated onto every generated accessor, builder and equals/hashCode.
# JaCoCo skips @Generated members, and the SpotBugs exclude filter keys off the
# same annotation. Without this, generated code counts against the coverage
# threshold and produces SpotBugs findings you cannot fix by hand.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true

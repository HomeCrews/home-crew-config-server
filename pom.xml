<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath /> <!-- lookup parent from repository -->
  </parent>
  <groupId>com.homecrew</groupId>
  <artifactId>configserver</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>configserver</name>
  <!-- homecrew:standards:metadata:start -->
  <!--
    Project identity. Generated by _standards/add-github-meta.py from its
    REPOS table - edit that, not this block.

    Spring Initializr leaves <description/>, <url/>, <licenses>, <developers>
    and <scm> as empty stubs. Left empty, an MIT LICENSE file in the repo root
    says one thing and the pom says nothing, and the pom is what an SBOM or a
    dependency scanner reads.

    No <email> in <developer> on purpose. Published poms get scraped;
    .github/SECURITY.md carries the contact route instead.
  -->
  <description>Spring Cloud Config Server. Serves home-crew-config to every service.</description>
  <url>https://github.com/HomeCrews/home-crew-config-server</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/HomeCrews/home-crew-config-server/blob/dev/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>mThanuj</id>
      <name>Thanuj Mullaguri</name>
      <url>https://github.com/mThanuj</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/HomeCrews/home-crew-config-server.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/HomeCrews/home-crew-config-server.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/HomeCrews/home-crew-config-server</url>
  </scm>
  <!-- homecrew:standards:metadata:end -->
  <properties>
    <java.version>25</java.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <!-- homecrew:standards:properties:start -->
    <!--
      Quality-gate tool versions.

      CONFIRMED - these exact versions are present in the local ~/.m2 cache
      and are a known-good set:
        spotless 2.43.0
        maven-checkstyle-plugin 3.6.0

      UNCONFIRMED - pinned from memory and NOT yet verified against Maven
      Central, because the machine these were authored on has no HTTP route to
      it. Run _standards/resolve-versions.sh on a connected machine before the
      first build:
        checkstyle, spotbugs, jacoco, exec-maven-plugin

      Java 25 is the constraint that matters for the unconfirmed set.
      Checkstyle parses source; SpotBugs and JaCoCo parse class files. Too old
      a release fails with "unsupported class file major version" or a parse
      error rather than anything useful. A Java 21 project would pin jacoco
      0.8.11, so versions taken from one are NOT safe to copy here.

      There is deliberately NO property for the Java formatter. Spotless's
      <eclipse> step resolves Eclipse JDT from the p2 site at
      download.eclipse.org rather than Maven Central, so resolve-versions.sh
      cannot check it and a version pinned here would be misleading. See the
      comment on the step itself in pom-plugins.xml.
    -->
    <spotless.version>2.43.0</spotless.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>11.0.1</checkstyle.version>
    <spotbugs-maven-plugin.version>4.9.6.0</spotbugs-maven-plugin.version>
    <spotbugs.version>4.9.6</spotbugs.version>
    <jacoco.version>0.8.14</jacoco.version>
    <exec-maven-plugin.version>3.5.1</exec-maven-plugin.version>

    <!-- Set true to skip pointing git at .githooks during the build. -->
    <hooks.install.skip>false</hooks.install.skip>

    <!--
      Minimum line coverage, 0.00-1.00. Starts at zero so the gate can be
      installed before the tests exist; raise it to the measured baseline
      (see _standards/README.md, Phase 3) and ratchet upward from there.
    -->
    <jacoco.min.coverage>0.00</jacoco.min.coverage>
    <!-- homecrew:standards:properties:end -->
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-config-server</artifactId>
    </dependency>
    <dependency>
      <!--
        Basic auth in front of the config and encryption endpoints. Needed only
        since this server started decrypting {cipher} values: before that it
        served placeholders and a leak cost nothing. NOT needed for the
        encryption itself - spring-security-crypto already arrives with
        spring-cloud-config-server.
      -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!--
        Hot reload for the containerised dev loop: see ./dev up in
        home-crew-infrastructure. DevTools POLLS the classpath rather than using
        inotify, which is the only reason it works across a Docker bind mount -
        inotify events do not cross one on macOS or Windows, so a
        WatchService-based watcher would see nothing at all.

        optional, and inert in production either way: DevTools disables itself
        when it detects it is running from a fully packaged jar, which is how
        every image in this project starts its process.
      -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- homecrew:standards:plugins:start -->

      <!--
        Points git at .githooks at the start of every build, so a fresh clone
        is protected without anyone remembering a setup step.

        Bound to validate, not initialize: validate is the FIRST lifecycle
        phase, and initialize comes after it. Bound to initialize, a plain
        `mvn validate` would finish without ever installing the hooks - which
        is exactly the command someone runs to set a repo up. This plugin is
        declared before Spotless so it wins the same-phase ordering.

        Invokes git directly rather than a shell script: `sh` is not reliably
        on PATH on Windows outside Git Bash, whereas git necessarily is if you
        are building from a clone. Exit 128 (not a git work tree - a source
        tarball, say) is treated as success so it can never fail a build.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>install-git-hooks</id>
            <phase>validate</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${hooks.install.skip}</skip>
              <executable>git</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>config</argument>
                <argument>core.hooksPath</argument>
                <argument>.githooks</argument>
              </arguments>
              <successCodes>
                <successCode>0</successCode>
                <successCode>128</successCode>
              </successCodes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Formatting. Google style: 2-space indent, 100-col. Bound to validate so
        it fails before anything is compiled.

        Declaration order matters: Spotless and Checkstyle both bind to
        validate, and Maven runs same-phase plugins in the order they are
        declared. Spotless must come first so formatting is settled before
        Checkstyle judges it. Do not reorder these two.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <!--
            Pin LF rather than inheriting the platform. Without this, a Windows
            checkout formats to CRLF and every file reads as a violation. The
            eol=lf rules in .gitattributes are the other half of the same fix.
          -->
          <lineEndings>UNIX</lineEndings>
          <java>
            <!--
              The Eclipse formatter, not google-java-format, and the reason is
              the editor rather than the output.

              google-java-format has no VS Code integration, so format-on-save
              runs Eclipse JDT instead and the two disagree on wrapping. Every
              save reintroduced a violation. Pointing BOTH at one profile - the
              build here, the editor via java.format.settings.url in
              .vscode/settings.json - means saving produces bytes that
              spotless:check already accepts. config/eclipse-formatter.xml is
              Google Java Style, so the style itself is unchanged.

              Cost, so nobody is surprised by it: this step resolves Eclipse JDT
              from the p2 site at https://download.eclipse.org, NOT from Maven
              Central. A cold build needs to reach it. The version is an Eclipse
              PLATFORM release (4.x), not an artifact version - do not try to
              look it up on Central, and note spotless-eclipse-jdt on Central is
              a dead 2021 artifact that this does not use.

              <version> is deliberately omitted so Spotless picks the release it
              ships support for. Pin it here once a build has confirmed which
              one that is.
            -->
            <eclipse>
              <file>${project.basedir}/config/eclipse-formatter.xml</file>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,jakarta,org,com,</order>
            </importOrder>
            <!--
              No formatAnnotations here. It is a google-java-format fixup, and
              the editor has no equivalent, so it would reintroduce exactly the
              build-disagrees-with-save problem this change exists to remove.
              Annotation placement comes from the profile instead.
            -->
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>

          <!--
            Everything that is not Java. Whitespace hygiene only, and that is a
            deliberate ceiling rather than a first step:

            - sortPom would reorder every pom. The marker comments apply.py
              keys off (homecrew:standards:properties:start and friends) would
              be moved away from the blocks they delimit, and re-running
              apply.py would stop being idempotent.
            - <yaml><jackson/> rewrites YAML through Jackson, which DROPS
              COMMENTS. home-crew-config and docker-compose.yml are mostly
              comments explaining why each value is what it is; that would
              delete the actual content of this project.
            - <yaml><prettier/> keeps comments but needs Node on PATH in every
              build, including CI and the dev containers.
            - An XML formatter (eclipseWtp) needs its own Eclipse config and
              reflows the long explanatory comments these poms are built on.

            So: the two rules that actually rot - trailing whitespace and a
            missing final newline - enforced everywhere, and nothing that
            rewrites a file's structure. These mirror .editorconfig, which
            until now nothing checked.
          -->
          <formats>
            <format>
              <includes>
                <include>**/*.yml</include>
                <include>**/*.yaml</include>
                <include>**/*.xml</include>
                <include>**/*.properties</include>
                <include>**/*.sh</include>
                <include>.githooks/**</include>
                <include>.gitattributes</include>
                <include>.gitignore</include>
                <include>.editorconfig</include>
                <include>Dockerfile</include>
              </includes>
              <excludes>
                <exclude>target/**</exclude>
                <exclude>.git/**</exclude>
                <!--
                  Both generated by the Maven wrapper, and .gitattributes pins
                  *.cmd to CRLF - which endWithNewline and a LF-normalising
                  build would fight over on every checkout.
                -->
                <exclude>mvnw</exclude>
                <exclude>**/*.cmd</exclude>
                <exclude>.mvn/wrapper/**</exclude>
              </excludes>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </format>

            <!--
              Markdown gets the newline rule but NOT trimTrailingWhitespace: two
              trailing spaces are a hard line break in Markdown, so stripping
              them silently changes rendered output. .editorconfig carves out the
              same exception.

              Note that endWithNewline still normalises whitespace at the END OF
              FILE - it trims it and appends exactly one newline - so a hard
              break on the very last line does get removed. That is harmless,
              since a line break before end-of-file renders as nothing anyway.
            -->
            <format>
              <includes>
                <include>**/*.md</include>
              </includes>
              <excludes>
                <exclude>target/**</exclude>
              </excludes>
              <endWithNewline/>
            </format>
          </formats>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Conventions and semantics. Cosmetic rules are deliberately absent from
        the ruleset; Spotless owns whitespace. Checkstyle core is pinned
        explicitly because the plugin's bundled default cannot parse Java 25.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${maven-checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>config/checkstyle.xml</configLocation>
          <!-- Sets the checkstyle.suppressions.file property the
               SuppressionFilter in checkstyle.xml reads. -->
          <suppressionsLocation>config/checkstyle-suppressions.xml</suppressionsLocation>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <!-- See the note in config/checkstyle.xml: scanning resources
               produces phantom tab violations in .properties files. -->
          <includeResources>false</includeResources>
          <includeTestResources>false</includeTestResources>
          <inputEncoding>${project.build.sourceEncoding}</inputEncoding>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <!-- failsOnError covers Checkstyle itself erroring out (an
               unparseable file, say). Without it a file Checkstyle cannot
               read is silently skipped rather than blocking. -->
          <failsOnError>true</failsOnError>
          <violationSeverity>warning</violationSeverity>
          <linkXRef>false</linkXRef>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-validate</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Static bug detection over compiled bytecode, so it runs at verify.
        Exclusions live in config/spotbugs-exclude.xml and are narrow on
        purpose: anything not excluded blocks the build.
      -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs-maven-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs</artifactId>
            <version>${spotbugs.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <failOnError>true</failOnError>
          <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
          <xmlOutput>true</xmlOutput>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Coverage. Lombok-generated members are skipped via @lombok.Generated
        (see lombok.config), so the ratio reflects hand-written code only.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <!-- Plugin-level so the HTML report and the threshold check agree on
             what counts. Set only on the check execution, the report would
             still include these and show a different number. -->
        <configuration>
          <excludes>
            <exclude>**/*Application.class</exclude>
            <exclude>**/config/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.min.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- homecrew:standards:plugins:end -->
    </plugins>
  </build>
</project>
